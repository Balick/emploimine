# Copy this file to .env.local and fill in the values.
# Only variables prefixed with NEXT_PUBLIC_ are exposed to the browser.

# --- Supabase (Project Settings > API) -------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# Public key: can only READ offers (enforced by row level security).
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Secret key: used by the scraper and the newsletter. Never expose it.
SUPABASE_SERVICE_ROLE_KEY=

# --- Site ---------------------------------------------------------------------
# Public URL, used in emails, sitemap and share links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Emails (optional: without them, no email is sent) ------------------------
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
# Defaults to "EmploiMine <SMTP_USER>".
EMAIL_FROM=
